[Unit]
Description=Smart speaker voice assistant
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=velix
WorkingDirectory=/opt/voice-assistant
ExecStart=/opt/voice-assistant/.venv/bin/voice-assistant
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Secrets live outside the repo; optional env file (create on the Pi):
#   /etc/voice-assistant.env with OPENWEBUI_BASE_URL=... and OPENWEBUI_API_KEY=...
EnvironmentFile=-/etc/voice-assistant.env

[Install]
WantedBy=multi-user.target
